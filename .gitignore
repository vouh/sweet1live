# env — single local secrets file at repo root (never commit)
.env.local
.env*
!.env.example

# legacy / duplicate env files
backend/.env
backend/.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

