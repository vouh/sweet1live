# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — single local secrets file at repo root (never commit)
.env.local
.env*
!.env.example

# legacy / duplicate env files
backend/.env
backend/.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source JPGs — site serves WebP from public/images/
public/images/s*.jpg

# hero video originals — site ships public/videos/brunch-vibes.mp4 only
public/videos/*.source.mp4
public/videos/*FINAL*.mp4

# Stripe CLI binary (run scripts/install-stripe-cli.ps1)
tools/stripe/stripe.exe

# Local database files (pytest throwaway DBs only — production uses Supabase PostgreSQL)
*.db
*.db-journal
*.sqlite
*.sqlite3
test_*.db

# Python — bytecode, caches, venvs (created on every `python` / pytest run)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/
.eggs/
*.egg
*.egg-info/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.manifest
*.spec

# local uploads / scratch (if any dev storage folder is used)
uploads/
backend/uploads/
tmp/
temp/

# IDE & local AI tooling (machine-specific, never commit)
.claude/
.cursor/
.idea/
*.swp
*.swo
*~
