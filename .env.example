# Copy to .env.local and fill in values. .env.local is gitignored.

# =============================================================================
# 1. FRONTEND — Next.js
#    NEXT_PUBLIC_* is safe to expose in the browser.
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=GTM-PSGB37L9
NEXT_PUBLIC_META_PIXEL_ID=319679979824179
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SevenRooms — table reservations only (tickets/events stay on Stripe)
NEXT_PUBLIC_SEVENROOMS_VENUE_ID=sweet1nerestaurantloungechingfordvenue
# Optional override; defaults to the venue explore booking URL
# NEXT_PUBLIC_SEVENROOMS_BOOKING_URL=https://www.sevenrooms.com/explore/sweet1nerestaurantloungechingfordvenue/reservations/create/search/

RESEND_API_KEY=
RESEND_FROM=

# Bootstrap super admin (created on first API start if missing)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# =============================================================================
# 2. BACKEND — FastAPI
#    Everything below is server-only.
# =============================================================================

# Supabase PostgreSQL (required — get from Supabase → Project Settings → Database)
DATABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_SITE_URL=http://localhost:3000
CURRENCY=gbp
# When Stripe charges another currency (e.g. USD), convert to CURRENCY on payment.
CONVERT_FOREIGN_PAYMENTS=true
CHECKOUT_HOLD_MINUTES=30

STAFF_API_KEY=
JWT_SECRET=

# Optional — Cloudflare Turnstile for public enquiry forms (contact, reservations, venue hire).
# When TURNSTILE_SECRET_KEY is set on the API, forms must pass verification.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# =============================================================================
# 3. STRIPE — payments (hosted Checkout — 2 vars only)
# =============================================================================

# sk_test_… (dev) or sk_live_… (real charges)
STRIPE_SECRET_KEY=

# whsec_… from: stripe listen --forward-to localhost:8000/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# pk_… and rk_… keys are NOT used by this project.

# Canonical production domain for sitemap.xml and robots.txt (no trailing path).
# SITE_URL=https://your-live-domain.com
