# Copy to .env.local and fill in values. .env.local is gitignored.

# =============================================================================
# 1. FRONTEND — Next.js (browser-safe NEXT_PUBLIC_* only)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

RESEND_API_KEY=
RESEND_FROM=

# =============================================================================
# 2. BACKEND — FastAPI (server-only)
# =============================================================================
DATABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_SITE_URL=http://localhost:3000
CURRENCY=gbp
CHECKOUT_HOLD_MINUTES=30

STAFF_API_KEY=
JWT_SECRET=

# =============================================================================
# 3. STRIPE — payments
# =============================================================================
# Secret key — sk_test_… (local) or sk_live_… (production)
STRIPE_SECRET_KEY=

# Webhook signing secret — whsec_… from `stripe listen` or Stripe Dashboard
STRIPE_WEBHOOK_SECRET=

# Publishable (pk_…) and restricted (rk_…) keys are NOT used by this project.
