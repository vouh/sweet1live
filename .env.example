# Copy to .env.local and fill in values. .env.local is gitignored.

# =============================================================================
# 1. FRONTEND — Next.js
#    NEXT_PUBLIC_* is safe to expose in the browser.
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

RESEND_API_KEY=
RESEND_FROM=

# =============================================================================
# 2. BACKEND — FastAPI
#    Everything below is server-only.
# =============================================================================

DATABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_SITE_URL=http://localhost:3000
CURRENCY=gbp
CHECKOUT_HOLD_MINUTES=30

STAFF_API_KEY=
JWT_SECRET=

# =============================================================================
# 3. STRIPE — payments (hosted Checkout — 2 vars only)
# =============================================================================

# sk_test_… (dev) or sk_live_… (real charges)
STRIPE_SECRET_KEY=

# whsec_… from: stripe listen --forward-to localhost:8000/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# pk_… and rk_… keys are NOT used by this project.
