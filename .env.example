# Public site URL once deployed (used by some absolute links / Stripe returns via API)
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# FastAPI backend (Railway / Render / Fly / etc.) — leave unset to default to localhost in local dev
NEXT_PUBLIC_API_URL=https://your-api-host.example.com

# Optional — admin forgot-password email via Resend
# RESEND_API_KEY=re_...
# RESEND_FROM=Sweet1ne Live <hello@yourdomain.com>
