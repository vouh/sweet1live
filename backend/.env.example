# Local dev default (no setup required):
DATABASE_URL=sqlite:///./dev.db

# Supabase (Project Settings -> Database -> Connection string -> "URI", then swap
# postgresql:// for postgresql+psycopg2:// so SQLAlchemy picks the right driver):
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

CORS_ORIGINS=["http://localhost:3000"]

# ---------- Stripe ----------
# Test keys: https://dashboard.stripe.com/test/apikeys
# Leave STRIPE_SECRET_KEY empty to run the site with checkout disabled.
STRIPE_SECRET_KEY=sk_test_...

# Local: `stripe listen --forward-to localhost:8000/stripe/webhook` prints this.
# Production: the signing secret on the dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe returns the customer after hosted checkout.
PUBLIC_SITE_URL=http://localhost:3000

CURRENCY=gbp

# Minutes a pending checkout holds seats / a room slot before they are released.
# Stripe enforces a 30-minute floor on its own session expiry.
CHECKOUT_HOLD_MINUTES=30

# Shared secret for the door check-in endpoints (X-Staff-Key header).
STAFF_API_KEY=sweet1ne-dev-staff-key-change-me
